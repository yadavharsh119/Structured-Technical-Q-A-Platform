# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=structured_qa
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/structured_qa

# Session Security
SESSION_SECRET=dev_session_secret_change_in_production_32chars_min
SESSION_TTL_MINUTES=60
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# Security & CORS
CORS_ORIGIN=http://localhost:3000
