# Copy this file to the repository root as .env (used by Docker Compose and
# the end-to-end test) and to server/.env (used by the API, migrations and
# tests, which run with server/ as their working directory).

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# If host port 5432 is already in use, set DB_PORT to a free port and update
# DATABASE_URL to use the same port. Keep this file in root and server/ in sync.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=structured_qa
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/structured_qa

# Session Security
# Use a random secret of at least 32 characters outside local development.
SESSION_SECRET=dev_session_secret_change_in_production_32chars_min
SESSION_TTL_MINUTES=60
APP_BASE_URL=http://localhost:3000
# Set to true when the app is served over HTTPS. Cookies are always Secure when
# NODE_ENV=production, regardless of this value.
COOKIE_SECURE=false

# Security & CORS
# Comma-separated allowlist of trusted browser origins. Defaults to the local
# client URL when unset.
CORS_ORIGINS=http://localhost:3000

# Attachment storage (outside the web root; relative paths resolve from the
# server process working directory)
UPLOAD_DIR=uploads

# End-to-End Test (optional overrides; defaults are http://localhost:3000 and
# DATABASE_URL above). Read from the root .env only.
# BASE_URL=http://localhost:3000
