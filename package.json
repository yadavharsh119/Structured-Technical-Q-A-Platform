{
  "name": "structured-qa-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Structured Technical Q&A Platform Monorepo",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "npm run dev --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "postinstall": "node scripts/patch-cmd-shims.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  }
}
